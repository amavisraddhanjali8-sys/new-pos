# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# AWS RDS / AURORA POSTGRESQL CONFIGURATION
# ==========================================
AWS_ACCOUNT_ID="041436772015"
AWS_REGION="us-east-1"
AWS_RESOURCE_ARN="arn:aws:rds:us-east-1:041436772015:cluster:innovistaposdbaws"
AWS_ROLE_ARN="arn:aws:iam::041436772015:role/Vercel/access-innovistaposdbaws"

# PostgreSQL Database Connection Variables
PGHOST="innovistaposdbaws.cluster-cct88acowp78.us-east-1.rds.amazonaws.com"
PGPORT="5432"
PGDATABASE="postgres"
PGUSER="postgres"
PGPASSWORD=""
PGSSLMODE="require"
DATABASE_URL="postgres://postgres:@innovistaposdbaws.cluster-cct88acowp78.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require"
