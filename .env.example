# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# AWS RDS / AURORA POSTGRESQL CONFIGURATION
# ==========================================
inposdbaws_AWS_ACCOUNT_ID="041436772015"
inposdbaws_AWS_REGION="us-east-1"
inposdbaws_AWS_RESOURCE_ARN="arn:aws:rds:us-east-1:041436772015:cluster:innovistaposdbaws"
inposdbaws_AWS_ROLE_ARN="arn:aws:iam::041436772015:role/Vercel/access-innovistaposdbaws"
inposdbaws_PGDATABASE="postgres"
inposdbaws_PGHOST="innovistaposdbaws.cluster-cct88acowp78.us-east-1.rds.amazonaws.com"
inposdbaws_PGPORT="5432"
